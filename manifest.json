{
  "manifest_version": 3,
  "name": "Cleanup Nextdoor",
  "version": "0.1.0",
  "permissions": [],
  "host_permissions": [
    "*://nextdoor.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["*://nextdoor.com/news_feed*"],
      "js": ["main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}